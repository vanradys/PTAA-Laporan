{
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://www.adiyasawork.com/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "ptaa-laporan.vercel.app"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://workspaceapi-server-production-22d4.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
