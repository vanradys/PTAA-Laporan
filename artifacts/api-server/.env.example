# Copy isi template ini ke file .env, jangan isi secret asli di .env.example

# Backend API. Disarankan 5000 supaya tidak bentrok dengan frontend.
PORT=5000

# WAJIB PostgreSQL. Jangan pakai file:./dev.db karena project ini memakai node-postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Header seed: x-seed-secret
SEED_SECRET=ptaa-seed-2026

# Secret login/session
JWT_SECRET=ptaa-jwt-secret-2026

NODE_ENV=development
